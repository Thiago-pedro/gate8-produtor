{
  "expo": {
    "name": "Gate8 Manager",
    "slug": "gate8-produtor",
    "owner": "thiago-gate8",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gate8produtor",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.gate8.produtor",
      "infoPlist": {
        "CFBundleDisplayName": "Gate8 Manager",
        "LSApplicationQueriesSchemes": [
          "gate8"
        ],
        "NSFaceIDUsageDescription": "O Gate8 usa o rosto ou a digital para abrir a sua conta neste celular."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "club.gate8.produtor",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "enableFullScreenImage_legacy": true
        }
      ],
      "./plugins/withFullScreenSplash.js",
      "./plugins/withCmakeStl.js",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Gate8 usa o rosto ou a digital para abrir a sua conta neste celular."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Gate8 Manager usa suas fotos para enviar a arte e o mapa do evento.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "641c28a9-3411-4726-ba57-a8032b2353bf"
      }
    }
  }
}
