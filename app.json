{
  "expo": {
    "name": "GATE8 Produtor",
    "slug": "gate8-produtor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gate8produtor",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.gate8.produtor",
      "infoPlist": {
        "CFBundleDisplayName": "GATE8 Produtor",
        "LSApplicationQueriesSchemes": [
          "gate8"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "club.gate8.produtor",
      "adaptiveIcon": {
        "backgroundColor": "#001B92",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Gate8 Produtor usa suas fotos para enviar a arte e o mapa do evento.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
